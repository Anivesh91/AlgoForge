NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/algoforge
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-3.6-flash

# Runner Sandbox Configuration
RUNNER_IMAGE=algoforge-cpp-runner:latest
RUN_TIMEOUT_MS=2000
RUN_MEMORY_MB=256
MAX_OUTPUT_KB=256

# Upload Configuration
UPLOAD_MAX_MB=5

# Storage (Optional / Local / S3)
STORAGE_PROVIDER=local
STORAGE_KEY=
STORAGE_SECRET=
